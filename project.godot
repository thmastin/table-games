; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows direct editing.
; See: https://docs.godotengine.org/en/stable/classes/class_projectsettings.html

config_version=5

[application]

config/name="Table Games"
config/features=PackedStringArray("4.3", "C#")
config/icon="res://icon.svg"

[autoload]

GlobalState="*res://shared/autoloads/GlobalState.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=0
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="TableGames"

[rendering]

renderer/rendering_method="gl_compatibility"
